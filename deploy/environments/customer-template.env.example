# Generated runtime copy: runtime/customer-template/.env
# This template intentionally contains no demo data, password, email or token.
APP_ENV=customer-template
APP_MODE=production
COMPOSE_PROJECT_NAME=executive-ai-customer-template
RUNTIME_DIR=./runtime/customer-template

# Local preparation is loopback-only. A customer deployment must add TLS and
# an explicitly approved network boundary before HOST_BIND may be changed.
HOST_BIND=127.0.0.1
HTTP_PORT=8180
PUBLIC_BASE_URL=http://127.0.0.1:8180
ALLOWED_ORIGINS=http://127.0.0.1:8180,http://localhost:8180
TRUSTED_HOSTS=127.0.0.1,localhost,api
COOKIE_SECURE=false

FILE_ENCRYPTION_KEY_VERSION=v1
AUDIT_HMAC_KEY_VERSION=v1
AUDIT_HMAC_LEGACY_KEY_VERSION=v1

# Copy these values from the approved signed release bundle. start-release.sh
# refuses a missing or mismatched version, commit, migration head or image digest.
RELEASE_GITHUB_REPOSITORY=Mino-Zhang/executive-ai-secretary
RELEASE_VERSION=
RELEASE_GIT_COMMIT=
EXPECTED_ALEMBIC_HEAD=c5d91f4a8b72

POSTGRES_USER=executive_ai
POSTGRES_MIGRATOR_USER=executive_ai_migrator
POSTGRES_RUNTIME_USER=executive_ai_runtime
POSTGRES_BACKUP_USER=executive_ai_backup
POSTGRES_DB=executive_ai_customer

# Security invariant: this must remain false in customer-template.
SEED_DEMO_DATA=false
DEMO_ENVIRONMENT_LABEL=

LOG_LEVEL=INFO
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_JOB_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=2
WORKER_RETRY_MAX_SECONDS=60

WEB_IMAGE=executive-ai-web:local
API_IMAGE=executive-ai-api:local
WORKER_IMAGE=executive-ai-worker:local
POSTGRES_IMAGE=docker.io/library/postgres@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
NGINX_IMAGE=docker.io/library/nginx@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
FILE_TOOL_IMAGE=docker.io/library/alpine@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
