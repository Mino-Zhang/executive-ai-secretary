# Generated runtime copy: runtime/local-demo/.env
# This template contains no secret and no default credential.
APP_ENV=local-demo
APP_MODE=demo
COMPOSE_PROJECT_NAME=executive-ai-local-demo
RUNTIME_DIR=./runtime/local-demo

# The gateway is deliberately loopback-only. Do not change for an onsite demo.
HOST_BIND=127.0.0.1
HTTP_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
TRUSTED_HOSTS=127.0.0.1,localhost,api
COOKIE_SECURE=false

FILE_ENCRYPTION_KEY_VERSION=v1
AUDIT_HMAC_KEY_VERSION=v1
AUDIT_HMAC_LEGACY_KEY_VERSION=v1

POSTGRES_USER=executive_ai
POSTGRES_MIGRATOR_USER=executive_ai_migrator
POSTGRES_RUNTIME_USER=executive_ai_runtime
POSTGRES_BACKUP_USER=executive_ai_backup
POSTGRES_DB=executive_ai_demo

# Demo data is never seeded as a side effect of startup. Use scripts/seed-demo.sh.
SEED_DEMO_DATA=false
DEMO_ENVIRONMENT_LABEL=本机脱敏演示环境

LOG_LEVEL=INFO
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_JOB_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=2
WORKER_RETRY_MAX_SECONDS=60

WEB_IMAGE=executive-ai-web:local
API_IMAGE=executive-ai-api:local
WORKER_IMAGE=executive-ai-worker:local
POSTGRES_IMAGE=postgres:17-alpine
NGINX_IMAGE=nginx:1.27-alpine
FILE_TOOL_IMAGE=alpine:3.20
